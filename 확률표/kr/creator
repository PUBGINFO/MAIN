<script>
  const SHEET_ID = '1K2Q4loa65fnmIWM70UW4BA_bs894VUIBClE6gqUHOMU';
  const CSV_URL  = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=확률표`;

  // ── 등급 정의: 골드 추가 (GO 배열 = 높은 등급 → 낮은 등급 순서) ──
  const GS = {
    '골드':  { color:'#e8a020', bg:'rgba(232,160,32,.13)', bd:'rgba(232,160,32,.3)' },
    '레드':  { color:'#f04e4e', bg:'rgba(240,78,78,.13)',  bd:'rgba(240,78,78,.3)'  },
    '핑크':  { color:'#e060a8', bg:'rgba(224,96,168,.13)', bd:'rgba(224,96,168,.3)' },
    '퍼플':  { color:'#9660dc', bg:'rgba(150,96,220,.13)', bd:'rgba(150,96,220,.3)' },
    '블루':  { color:'#4488e8', bg:'rgba(68,136,232,.13)', bd:'rgba(68,136,232,.3)' },
    '그린':  { color:'#38b870', bg:'rgba(56,184,112,.13)', bd:'rgba(56,184,112,.3)' },
  };
  const GO = ['골드','레드','핑크','퍼플','블루','그린'];

  let sheetData = {}, orderedKeys = [];
  let tierData  = {}; // 라운드/할인율 표 (예: Double Lucky Treasure) 전용 저장소
  let currentView  = 'all';
  let currentCrate = null;

  // ── 등급 멀티셀렉트: 빈 Set = 전체 표시 ──
  let selectedGrades = new Set();

  // ── 정렬 상태 ──
  // sortMode: 'grade' | 'prob'
  // sortDir : 1 = 기본(골드↓ / 높은 확률↓), -1 = 반전(그린↓ / 낮은 확률↓)
  let sortMode = 'grade';
  let sortDir  = 1;

  // ─────────────────────────────────────────
  async function fetchWithTimeout(url, ms) {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), ms);
    try {
      const r = await fetch(url, { signal: ctrl.signal, cache: 'no-store' });
      return r;
    } finally {
      clearTimeout(t);
    }
  }

  async function loadSheet(attempt = 1) {
    try {
      const r = await fetchWithTimeout(CSV_URL, 9000);
      if (!r.ok) throw new Error('bad status ' + r.status);
      const text = await r.text();
      parseSheet(text);
      onLoaded();
    } catch(e) {
      if (attempt < 2) { loadSheet(attempt + 1); return; } // 한 번 재시도
      document.getElementById('loading').classList.add('hide');
      document.getElementById('load-err').classList.add('show');
    }
  }

  function csvToRows(text) {
    const rows = [];
    for (const line of text.split('\n')) {
      const cols = []; let cur = '', inQ = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') { inQ = !inQ; continue; }
        if (ch === ',' && !inQ) { cols.push(cur.trim()); cur = ''; continue; }
        cur += ch;
      }
      cols.push(cur.trim()); rows.push(cols);
    }
    return rows;
  }

  function sectionNameFromHeaderRow(rows, i) {
    let nr = i - 1;
    while (nr >= 0 && !(rows[nr][0]||'').toString().trim()) nr--;
    const raw  = nr >= 0 ? (rows[nr][0]||'').toString() : '';
    const name = raw.replace(/[■▣□◆◇●◎▷\[\]]/g,'').replace(/\s*\d{1,2}:\d{2}~?\s*$/,'').replace(/~\s*$/,'').replace(/\s+/g,' ').trim();
    return { name, nr };
  }

  function uniqueKey(name, nr, rows, store) {
    let key = name;
    if (store[key]) {
      const bc=(rows[nr]?(rows[nr][1]||rows[nr][2]||''):'').toString();
      const dm=bc.match(/\d{4}-\d{2}-\d{2}/)||bc.match(/\d{2,4}[.\-]\d{1,2}[.\-]\d{1,2}/);
      const existing = Object.keys(store).filter(k=>k===name||k.startsWith(name+' ('));
      key = dm ? `${name} (${dm[0]})` : `${name} (${existing.length+1})`;
    }
    return key;
  }

  function parseSheet(text) {
    const rows = csvToRows(text);
    sheetData = {}; orderedKeys = [];
    tierData  = {};
    const secs = [];
    for (let i = 0; i < rows.length; i++) {
      const c0 = (rows[i][0]||'').toString().trim();
      if (c0 === '아이템 명(KR)' || c0 === '아이템명(KR)' || c0.includes('아이템 명(KR)')) {
        const { name, nr } = sectionNameFromHeaderRow(rows, i);
        if (name) secs.push({ name, hi: i, nr, type: 'items' });
      } else if (c0 === '라운드') {
        // 라운드/할인율/노출확률 다단 표 (예: Double Lucky Treasure 할인 확률표)
        const { name, nr } = sectionNameFromHeaderRow(rows, i);
        if (name) secs.push({ name, hi: i, nr, type: 'tiers' });
      }
    }
    // hi 기준 정렬 후 섹션 경계 계산 (타입 혼재 시에도 안전하게)
    secs.sort((a,b)=>a.hi-b.hi);

    for (let s = 0; s < secs.length; s++) {
      const { name, hi, nr, type } = secs[s];
      const end = s+1 < secs.length ? secs[s+1].nr : rows.length;

      if (type === 'tiers') {
        const tiers = parseTierSection(rows, hi, end);
        if (!tiers.length) continue;
        const key = uniqueKey(name, nr, rows, tierData);
        tierData[key] = tiers;
        orderedKeys.push(key);
        continue;
      }

      const hdr = rows[hi].map(c=>(c||'').toString().trim());
      const gi  = hdr.findIndex(h=>h.includes('등급'));
      const pi  = hdr.findIndex(h=>h==='확률'||h.startsWith('확률'));
      const items = [];
      for (let r = hi+1; r < end; r++) {
        const row = rows[r];
        const c0  = (row[0]||'').toString().trim();
        if (!c0 || c0==='총합' || c0.startsWith('*') || /^\d+\./.test(c0)) continue;
        const grade = gi !== -1 ? (row[gi]||'').toString().trim() : '';
        let prob = pi !== -1 ? parseFloat((row[pi]||'').toString().replace('%','')) : NaN;
        if (isNaN(prob)||prob<=0) {
          for (let ci=2;ci<row.length;ci++) {
            const n=parseFloat((row[ci]||'').toString().replace('%',''));
            if(!isNaN(n)&&n>0&&n<100){prob=n;break;}
          }
        }
        if (isNaN(prob)||prob<=0||prob>=100) continue;
        items.push({ item: c0, grade, prob });
      }
      if (!items.length) continue;
      const key = uniqueKey(name, nr, rows, sheetData);
      sheetData[key]=items; orderedKeys.push(key);
    }
    orderedKeys.reverse();
  }

  /* ── 라운드/할인율 다단 표 파서 (Double Lucky Treasure 형태) ──
     헤더 예: 라운드 | 적용 할인율 | 노출 확률 | 적용 할인율 | 노출 확률 | ... | 적용 할인율 | 노출 확률 | Total
     마지막 "적용 할인율" 칼럼 앞에 라벨(예: Lucky)이 오는 변형도 지원 */
  function parseTierSection(rows, hi, end) {
    const hdr = rows[hi].map(c=>(c||'').toString().trim());
    // "적용 할인율" 이 나타나는 각 칼럼 인덱스를 티어(단계)로 취급
    const tierCols = [];
    hdr.forEach((h, ci) => { if (h.includes('적용 할인율')) tierCols.push(ci); });
    const totalCi = hdr.findIndex(h => h.toLowerCase().includes('total'));

    const out = [];
    for (let r = hi+1; r < end; r++) {
      const row = rows[r];
      const c0 = (row[0]||'').toString().trim();
      if (!c0) continue;
      const roundLabel = c0;
      const tiers = tierCols.map(ci => {
        const rateRaw = (row[ci]||'').toString().trim();
        const labelOrExposure = (row[ci+1]||'').toString().trim();
        // 다음 칼럼이 숫자/퍼센트면 노출확률, 아니면 라벨(예: "Lucky")+그 다음 칼럼이 노출확률
        const asNum = parseFloat(labelOrExposure.replace('%',''));
        if (!isNaN(asNum) && labelOrExposure.includes('%')) {
          return { rate: rateRaw, label: '', exposure: labelOrExposure };
        }
        const exposureRaw = (row[ci+2]||'').toString().trim();
        return { rate: rateRaw, label: labelOrExposure, exposure: exposureRaw };
      });
      const total = totalCi !== -1 ? (row[totalCi]||'').toString().trim() : '';
      if (!tiers.some(t => t.rate || t.exposure)) continue;
      out.push({ round: roundLabel, tiers, total });
    }
    return out;
  }

  // breadcrumb에는 날짜 등 괄호 접미사를 생략해 아래 제목과 중복되지 않게 표시
  function stripDateSuffix(name) { return name.replace(/\s*\([^)]*\)\s*$/, '').trim() || name; }

  function isTierKey(key) { return !!tierData[key]; }
  function countFor(key) { return isTierKey(key) ? tierData[key].length : (sheetData[key]||[]).length; }

  function onLoaded() {
    document.getElementById('loading').classList.add('hide');
    const totalItems = orderedKeys.reduce((s,k)=>s+countFor(k),0);
    document.getElementById('stat-crates').textContent = orderedKeys.length;
    document.getElementById('stat-items').textContent  = totalItems;
    document.getElementById('live-count').textContent  = orderedKeys.length;
    document.getElementById('live-badge').style.display = 'flex';
    renderSidebar(orderedKeys);
    renderAllView();
  }

  /* ── SIDEBAR ── */
  function renderSidebar(keys) {
    const list = document.getElementById('sb-list');
    list.querySelectorAll('.crate-item').forEach(e=>e.remove());
    document.getElementById('sb-lbl').textContent = `${keys.length}개 상자`;
    for (const key of keys) {
      const d = document.createElement('div');
      d.className = 'crate-item';
      d.dataset.key  = key;
      d.dataset.name = key.toLowerCase();
      d.innerHTML = `<div class="ci-name">${key}</div><div class="ci-count">${countFor(key)}</div>`;
      d.onclick = () => { selectCrate(key); closeSB(); };
      list.appendChild(d);
    }
  }

  function filterSidebar() {
    const q = document.getElementById('sb-search-input').value.toLowerCase();
    let vis = 0;
    document.querySelectorAll('.crate-item').forEach(el => {
      const show = !q || el.dataset.name.includes(q);
      el.style.display = show ? '' : 'none';
      if (show) vis++;
    });
    document.getElementById('sb-lbl').textContent = `${vis}개 상자`;
  }

  /* ── ALL VIEW 아이템 검색 ── */
  function filterAllView() {
    const q = (document.getElementById('all-search-input')?.value || '').toLowerCase().trim();
    const cards = document.querySelectorAll('#all-grid .crate-card');
    let vis = 0;
    cards.forEach(card => {
      const key = card.dataset.key;
      const nameMatch = key.toLowerCase().includes(q);
      const matchedItems = q && !isTierKey(key) ? (sheetData[key] || []).filter(i => i.item.toLowerCase().includes(q)) : [];
      const itemMatch = matchedItems.length > 0;
      const show = !q || nameMatch || itemMatch;
      card.style.display = show ? '' : 'none';
      const prev = card.querySelector('.match-badge');
      if (prev) prev.remove();
      if (show && q && itemMatch && !nameMatch) {
        const meta = card.querySelector('.cc-meta');
        if (meta) {
          const badge = document.createElement('span');
          badge.className = 'match-badge';
          badge.style.cssText = 'color:var(--accent-lt);font-weight:600';
          badge.textContent = `"${q}" ${matchedItems.length}개 매칭`;
          meta.appendChild(badge);
        }
      }
      if (show) vis++;
    });
    const countEl = document.getElementById('all-search-count');
    const emptyEl = document.getElementById('all-empty');
    if (countEl) countEl.textContent = q ? `${vis}개 결과` : '';
    if (emptyEl) emptyEl.style.display = vis === 0 ? 'block' : 'none';
  }

  /* ── VIEW SWITCH ── */
  function switchView(v) {
    currentView = v;
    document.getElementById('svt-all').classList.toggle('active',    v==='all');
    document.getElementById('svt-detail').classList.toggle('active', v==='detail');
    if (v === 'all') {
      renderAllView();
    } else {
      if (currentCrate) renderDetailView(currentCrate);
      else showPickPrompt();
    }
  }

  /* ── ALL VIEW ── */
  let allViewCardsHTML = null; // 전체 목록 카드 HTML 캐시 (뒤로가기 시 재계산 방지)

  function buildAllViewCards() {
    return orderedKeys.map(key => {
      if (isTierKey(key)) {
        const tiers = tierData[key];
        return `<div class="crate-card" data-key="${key.replace(/"/g,'&quot;')}" onclick="selectCrateByEl(this)">
          <div class="cc-name">${key}</div>
          <div class="cc-meta"><span>뽑기 <span class="hl">${tiers.length}회</span></span><span>유형 <span class="hl">할인 확률표</span></span></div>
          <div class="cc-grades"><span class="cc-gtag" style="color:${GS['블루'].color};background:${GS['블루'].bg};border-color:${GS['블루'].bd}">TIER TABLE</span></div>
        </div>`;
      }
      const items = sheetData[key]||[];
      const gradeSum = {};
      let total = 0;
      for (const {grade,prob} of items) {
        if (grade) gradeSum[grade]=(gradeSum[grade]||0)+prob;
        total += prob;
      }
      const sortedG = Object.keys(gradeSum).sort((a,b)=>{
        const ai=GO.indexOf(a),bi=GO.indexOf(b);
        return (ai===-1?99:ai)-(bi===-1?99:bi);
      });
      const tags = sortedG.map(g=>{
        const gs=GS[g]||{color:'#888',bg:'rgba(128,128,128,.12)',bd:'rgba(128,128,128,.3)'};
        const pct=Math.round(gradeSum[g]*100)/100;
        return `<span class="cc-gtag" style="color:${gs.color};background:${gs.bg};border-color:${gs.bd}">${g} ${pct}%</span>`;
      }).join('');

      return `<div class="crate-card" data-key="${key.replace(/"/g,'&quot;')}" onclick="selectCrateByEl(this)">
        <div class="cc-name">${key}</div>
        <div class="cc-meta"><span>아이템 <span class="hl">${items.length}종</span></span><span>합계 <span class="hl">${Math.round(total*100)/100}%</span></span></div>
