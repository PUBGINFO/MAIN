  /* ── 확률 % 포맷: 불필요한 끝 0만 제거, 부동소수점 오차 보정 ── */
  function fmtProb(n) {
    // 부동소수점 누적 오차 보정을 위해 소수점 6자리에서 반올림
    let s = (Math.round(n*1e6)/1e6).toString();
    if (s.includes('.')) {
      s = s.replace(/0+$/, '').replace(/\.$/, '');
    }
    return s;
  }

  /* ── 캡쳐 보기: 시트 캡쳐처럼 한 화면에 표 전체를 쫙 펼쳐서 보여줌 ── */
  let captureRows = [], captureTitle = '', captureTotal = 0;

  function openCaptureView(key) {
    const items = sheetData[key] || [];
    const sorted = getSorted(items);
    let total = 0;
    const rowsHtml = sorted.map(item => {
      total += item.prob;
      const gs = GS[item.grade];
      const color = gs ? gs.color : '#333';
      return `<tr>
        <td class="cap-name">${item.item}</td>
        <td class="cap-grade" style="color:${color}">${item.grade||''}</td>
        <td class="cap-prob">${fmtProb(item.prob)}%</td>
      </tr>`;
    }).join('');

    const now = new Date();
    const dateStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;

    captureRows = sorted.map(item => ({
      name: item.item, grade: item.grade || '',
      color: (GS[item.grade] && GS[item.grade].color) || '#333',
      prob: item.prob
    }));
    captureTitle = stripDateSuffix(key);
    captureTotal = total;

    document.getElementById('capture-sheet').innerHTML = `
      <div class="cap-title-bar">
        <h2>${stripDateSuffix(key)}</h2>
        <div class="cap-meta">캡쳐 생성일 ${dateStr}</div>
      </div>
      <table class="cap-table">
        <thead>
          <tr>
            <th style="width:52%">아이템 명(KR)</th>
            <th style="width:18%">등급</th>
            <th style="width:30%">확률</th>
          </tr>
        </thead>
        <tbody>${rowsHtml}</tbody>
        <tfoot>
          <tr>
            <td class="cap-total-label" colspan="2">총합</td>
            <td class="cap-total-val">${fmtProb(total)}%</td>
          </tr>
        </tfoot>
      </table>`;

    document.getElementById('capture-modal-overlay').classList.add('show');
  }
  function closeCaptureView() {
    document.getElementById('capture-modal-overlay').classList.remove('show');
  }

  /* ── 캔버스로 표 전체를 하나의 PNG 이미지로 그려서 다운로드 ── */
  function saveCaptureAsImage() {
    const btn = document.getElementById('save-img-btn');
    const btnOrigHtml = btn.innerHTML;
    btn.innerHTML = '저장 중...';
    btn.disabled = true;

    // 레이아웃 상수 (원본 엑셀 캡처처럼 촘촘하게)
    const W = 1020;
    const padX = 20;
    const rowH = 24;
    const headH = 30;
    const titleH = 42;
    const footH = 26;
    const colName = W - padX*2 - 150 - 200; // 이름 컬럼 너비
    const colGradeW = 150;
    const colProbW = 200;

    const rows = captureRows;
    const H = titleH + headH + rows.length*rowH + footH + 24;

    const canvas = document.createElement('canvas');
    const scale = 2; // 레티나 화질
    canvas.width = W*scale;
    canvas.height = H*scale;
    canvas.style.width = W+'px';
    canvas.style.height = H+'px';
    const ctx = canvas.getContext('2d');
    ctx.scale(scale, scale);

    // 배경
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0,0,W,H);

    let y = 14;
    // 타이틀
    ctx.fillStyle = '#111827';
    ctx.font = '700 16px "Malgun Gothic","Apple SD Gothic Neo",sans-serif';
    ctx.textBaseline = 'alphabetic';
    ctx.fillText(captureTitle, padX, y+16);

    const now = new Date();
    const dateStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
    ctx.font = '400 11px "DM Mono",monospace';
    ctx.fillStyle = '#333333';
    ctx.textAlign = 'right';
    ctx.fillText('캡쳐 생성일 ' + dateStr, W-padX, y+15);
    ctx.textAlign = 'left';

    y = titleH;
    // 제목 아래 굵은 선
    ctx.strokeStyle = '#1a1a1a';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(padX, y); ctx.lineTo(W-padX, y); ctx.stroke();

    // 헤더
    const tableX = padX, tableW = W - padX*2;
    ctx.fillStyle = '#dbe7f5';
    ctx.fillRect(tableX, y, tableW, headH);
    ctx.strokeStyle = '#999999';
    ctx.lineWidth = 1;
    ctx.strokeRect(tableX, y, tableW, headH);

    const xName = tableX;
    const xGrade = tableX + colName;
    const xProb  = tableX + colName + colGradeW;

    ctx.strokeStyle = '#999999';
    ctx.beginPath(); ctx.moveTo(xGrade,y); ctx.lineTo(xGrade,y+headH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(xProb,y); ctx.lineTo(xProb,y+headH); ctx.stroke();

    ctx.fillStyle = '#111827';
    ctx.font = '700 12px "Malgun Gothic","Apple SD Gothic Neo",sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('아이템 명(KR)', xName+colName/2, y+headH/2+4);
    ctx.fillText('등급', xGrade+colGradeW/2, y+headH/2+4);
    ctx.fillText('확률', xProb+colProbW/2, y+headH/2+4);

    y += headH;

    // 바디 행
    rows.forEach((r, i) => {
      const rowY = y + i*rowH;
      if (i%2===1) { ctx.fillStyle = '#f7f9fc'; ctx.fillRect(tableX, rowY, tableW, rowH); }
      ctx.strokeStyle = '#cccccc';
      ctx.lineWidth = 1;
      ctx.strokeRect(tableX, rowY, tableW, rowH);
      ctx.beginPath(); ctx.moveTo(xGrade,rowY); ctx.lineTo(xGrade,rowY+rowH); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(xProb,rowY); ctx.lineTo(xProb,rowY+rowH); ctx.stroke();

      // 이름 (좌측 정렬, 길면 줄임)
      ctx.fillStyle = '#111827';
      ctx.font = '400 11.5px "Malgun Gothic","Apple SD Gothic Neo",sans-serif';
      ctx.textAlign = 'left';
      let name = r.name;
      const maxW = colName - 14;
      while (ctx.measureText(name).width > maxW && name.length > 1) {
        name = name.slice(0, -1);
      }
      if (name !== r.name) name = name.slice(0, -1) + '…';
      ctx.fillText(name, xName+7, rowY+rowH/2+4);

      // 등급 (중앙, 색상)
      ctx.fillStyle = r.color;
      ctx.font = '700 11.5px "Malgun Gothic","Apple SD Gothic Neo",sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(r.grade, xGrade+colGradeW/2, rowY+rowH/2+4);

      // 확률 (우측 정렬)
      ctx.fillStyle = '#111827';
      ctx.font = '400 11.5px "DM Mono",monospace';
      ctx.textAlign = 'right';
      ctx.fillText(fmtProb(r.prob)+'%', xProb+colProbW-8, rowY+rowH/2+4);
    });

    y += rows.length*rowH;

    // 총합 행
    ctx.fillStyle = '#eef2f7';
    ctx.fillRect(tableX, y, tableW, footH);
    ctx.strokeStyle = '#1a1a1a';
    ctx.lineWidth = 1.4;
    ctx.strokeRect(tableX, y, tableW, footH);
    ctx.beginPath(); ctx.moveTo(xProb,y); ctx.lineTo(xProb,y+footH); ctx.stroke();

    ctx.fillStyle = '#111827';
    ctx.font = '700 12px "Malgun Gothic","Apple SD Gothic Neo",sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('총합', tableX + (colName+colGradeW)/2, y+footH/2+4);

    ctx.fillStyle = '#0a7a3d';
    ctx.font = '700 12px "DM Mono",monospace';
    ctx.textAlign = 'right';
    ctx.fillText(fmtProb(captureTotal)+'%', xProb+colProbW-8, y+footH/2+4);

    // 폰트 로딩 뒤 재렌더 필요할 수 있어 약간 지연 후 다운로드
    setTimeout(() => {
      canvas.toBlob(blob => {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${captureTitle.replace(/[\\/:*?"<>|]/g,'_')}_확률표.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        btn.innerHTML = btnOrigHtml;
        btn.disabled = false;
      }, 'image/png');
    }, 80);
  }

  /* ── TIER TABLE DETAIL VIEW (Double Lucky Treasure 형태) ── */
  function renderTierDetailView(key) {
    const tiers = tierData[key]||[];
    const tierStepCount = tiers.length ? tiers[0].tiers.length : 0;

    document.getElementById('breadcrumb').innerHTML =
      `<span style="color:var(--txt3);cursor:pointer" onclick="renderAllView()">전체 목록</span>
       <span class="sep">›</span>
       <span class="cur">${stripDateSuffix(key)}</span>`;
    setMobBackPill(true);
    window.scrollTo(0,0);

    let theadCols = `<th>라운드</th>`;
    for (let i=0;i<tierStepCount;i++) theadCols += `<th>적용 할인율</th><th>노출 확률</th>`;
    theadCols += `<th>Total</th>`;

    const bodyRows = tiers.map(t => {
      let cols = `<td class="tier-round">${t.round}</td>`;
      for (const step of t.tiers) {
        const rateIsLabel = step.rate && !/%$/.test(step.rate); // 예: "Lucky" 처럼 %가 아닌 라벨
        cols += `<td class="${rateIsLabel?'tier-exp':''}">${step.rate||'—'}</td>`;
        cols += `<td>${step.exposure||'—'}</td>`;
      }
      cols += `<td class="tier-total">${t.total||'—'}</td>`;
      return `<tr>${cols}</tr>`;
    }).join('');

    document.getElementById('content').innerHTML = `
      <div class="detail-view">
        <div class="detail-head">
          <div class="detail-eyebrow">DISCOUNT / EXPOSURE TABLE</div>
          <div class="detail-title">${key}</div>
        </div>
        <div class="stat-cards">
          <div class="stat-card"><div class="sc-lbl">라운드</div><div class="sc-val">${tiers.length}<span>개</span></div></div>
          <div class="stat-card"><div class="sc-lbl">할인 단계</div><div class="sc-val">${tierStepCount}<span>단계</span></div></div>
        </div>
        <div class="tier-table-wrap">
          <table class="tier-table">
            <thead><tr>${theadCols}</tr></thead>
            <tbody>${bodyRows}</tbody>
          </table>
          <div class="tier-note">라운드별로 순차 적용되는 할인율과 각 단계의 노출 확률을 나타낸 표입니다. 시트 원본 값을 그대로 표시합니다.</div>
        </div>
      </div>`;
  }

  /* ── 정렬 핵심: sortDir 방향 반영 ── */
  function getSorted(items) {
    return [...items].sort((a, b) => {
      if (sortMode === 'prob') {
        // sortDir 1 = 높은 확률 먼저, -1 = 낮은 확률 먼저
        return sortDir === 1 ? b.prob - a.prob : a.prob - b.prob;
      }
      // 등급순
      const ai = GO.indexOf(a.grade), bi = GO.indexOf(b.grade);
      const diff = (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
      if (diff !== 0) {
        // sortDir 1 = 골드(인덱스0)→그린(인덱스5) 순, -1 = 반전
        return sortDir === 1 ? diff : -diff;
      }
      // 같은 등급 내에서는 확률 오름차순 (방향 무관)
      return a.prob - b.prob;
    });
  }

  function renderTable(items) {
    const sorted  = getSorted(items);
    const maxProb = Math.max(...items.map(i=>i.prob));
    const tbody   = document.getElementById('t-body');
    if (!tbody) return;
    tbody.innerHTML = '';
    let cumul = 0;
    sorted.forEach((item, idx) => {
      cumul += item.prob;
      const gs  = GS[item.grade];
      const pct = maxProb > 0 ? (item.prob/maxProb*100).toFixed(1) : 0;
      const barColor = gs ? gs.color : '#5a6a7a';
      const pill = item.grade
        ? `<span class="grade-pill" style="color:${gs?.color||'#888'};background:${gs?.bg||'rgba(128,128,128,.12)'};border-color:${gs?.bd||'rgba(128,128,128,.3)'}">
             <span class="grade-pill-dot" style="background:${gs?.color||'#888'}"></span>${item.grade}
           </span>` : '';
      const tr = document.createElement('div');
      tr.className = 't-row';
      tr.dataset.grade = item.grade;
      tr.dataset.item  = item.item.toLowerCase();
      tr.innerHTML = `
        <div class="td td-rank">${idx+1}</div>
        <div class="td td-name">${item.item}</div>
        <div class="td">${pill}</div>
        <div class="td td-prob"><span class="prob-num">${item.prob}</span><span class="prob-unit">%</span></div>
        <div class="td"><div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${barColor}"></div></div></div>
        <div class="td td-cumul">${Math.round(cumul*1000)/1000}%</div>`;
      tbody.appendChild(tr);
    });
  }

  /* ── 등급 멀티셀렉트 ── */
  function setGrade(g) {
    if (g === 'ALL') {
      // ALL 클릭 시 모든 선택 해제 → 전체 표시
      selectedGrades.clear();
    } else {
      // 토글: 있으면 제거, 없으면 추가
      if (selectedGrades.has(g)) {
        selectedGrades.delete(g);
      } else {
        selectedGrades.add(g);
      }
    }

    // ALL 칩: selectedGrades가 비어있을 때만 selected
    const allChipEl = document.getElementById('gsc-ALL');
    if (allChipEl) allChipEl.classList.toggle('selected', selectedGrades.size === 0);

    // 각 등급 칩 업데이트
    document.querySelectorAll('.gs-chip:not(.all)').forEach(el => {
      const chipGrade = el.id.replace('gsc-', '');
      el.classList.toggle('selected', selectedGrades.has(chipGrade));
    });

    // 멀티셀렉트 힌트 배지 업데이트
    const hintEl = document.getElementById('multi-hint');
    if (hintEl) {
      hintEl.textContent = selectedGrades.size > 1 ? `${selectedGrades.size}개 등급 선택됨` : '';
      hintEl.classList.toggle('show', selectedGrades.size > 1);
    }

    filterTable();
  }

  /* ── 정렬 모드 및 방향 토글 ── */
  function setSort(mode) {
    if (sortMode === mode) {
      // 같은 버튼 다시 누르면 방향 반전
      sortDir = sortDir === 1 ? -1 : 1;
    } else {
      // 다른 버튼 누르면 해당 모드로 전환, 방향 초기화
      sortMode = mode;
      sortDir  = 1;
    }

    // 버튼 active 상태 업데이트
    const gradeBtn = document.getElementById('sort-grade');
    const probBtn  = document.getElementById('sort-prob');
    if (gradeBtn) gradeBtn.classList.toggle('active', sortMode === 'grade');
    if (probBtn)  probBtn.classList.toggle('active',  sortMode === 'prob');

    // 방향 아이콘 업데이트
    const gradeDirEl = document.getElementById('sort-grade-dir');
    const probDirEl  = document.getElementById('sort-prob-dir');
    if (gradeDirEl) gradeDirEl.textContent = (sortMode === 'grade' && sortDir === -1) ? '↑' : '↓';
    if (probDirEl)  probDirEl.textContent  = (sortMode === 'prob'  && sortDir === -1) ? '↑' : '↓';

    if (currentCrate) renderTable(sheetData[currentCrate]||[]);
    filterTable();
  }

  /* ── 테이블 필터 (멀티셀렉트 + 이름 검색) ── */
  function filterTable() {
    const q = (document.querySelector('.filter-search input')?.value||'').toLowerCase();
    let vis = 0;
    document.querySelectorAll('#t-body .t-row').forEach(tr => {
      // 멀티셀렉트: 선택 Set이 비어있으면 전체, 아니면 포함 여부 확인
      const gradeOk = selectedGrades.size === 0 || selectedGrades.has(tr.dataset.grade);
      const ok = gradeOk && (!q || tr.dataset.item.includes(q));
      tr.classList.toggle('hidden', !ok);
      if (ok) vis++;
    });
    const empty = document.getElementById('t-empty');
    if (empty) empty.classList.toggle('show', vis===0);
  }

  /* ── THEME (기본: 라이트 모드) ── */
  let dark = false;
  function toggleTheme() {
    dark = !dark;
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    // dark=true: 달 아이콘 표시 / dark=false: 해 아이콘 표시
    document.getElementById('ico-dark').style.display  = dark ? 'none' : '';
    document.getElementById('ico-light').style.display = dark ? '' : 'none';
  }

  /* ── MOBILE ── */
  function openSB()  { document.getElementById('sidebar').classList.add('open'); document.getElementById('sb-overlay').classList.add('show'); }
  function closeSB() { document.getElementById('sidebar').classList.remove('open'); document.getElementById('sb-overlay').classList.remove('show'); }

  /* ── 모바일 상단 "목록" 백 필: 상세뷰에선 표시하고 햄버거는 숨김 ── */
  function setMobBackPill(show) {
    document.getElementById('mob-back-pill').classList.toggle('show', show);
    document.getElementById('mob-menu-btn').classList.toggle('hide-mob', show);
  }
  function goBackToList() { renderAllView(); }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeCaptureView();
  });

  loadSheet();
</script>
</body>
</html>
